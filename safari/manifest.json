{
  "manifest_version": 3,
  "name": "Browsing Journal",
  "version": "0.1.0",
  "description": "Logs pages you actually spend time on (window focused, not idle) to a local journal.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["shared.js", "background.js"] },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["activity.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Browsing Journal" }
}
